// PostgreSQL Database Schema for StockSense Inventory Management System via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum LedgerType {
  RECEIPT
  DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  name            String
  password        String
  role            Role          @default(WAREHOUSE_STAFF)
  resetOtp        String?
  resetOtpExpires DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  receiptsCreated    Receipt[]
  deliveriesCreated  Delivery[]
  transfersCreated   Transfer[]
  adjustmentsCreated Adjustment[]
  ledgerEntries      StockLedger[]
}

// ==========================================
// PRODUCT & CATEGORY
// ==========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String   @id @default(uuid())
  name         String
  sku          String   @unique
  categoryId   String
  unit         String   @default("units")
  reorderLevel Int      @default(10)
  costPrice    Decimal? @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  category      Category       @relation(fields: [categoryId], references: [id])
  stocks        Stock[]
  receiptItems  ReceiptItem[]
  deliveryItems DeliveryItem[]
  transferItems TransferItem[]
  adjustments   Adjustment[]
  ledgerEntries StockLedger[]

  @@index([sku])
  @@index([categoryId])
}

// ==========================================
// WAREHOUSE & LOCATION
// ==========================================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  locations            Location[]
  stocks               Stock[]
  receiptsDestination  Receipt[]     @relation("ReceiptDestinationWarehouse")
  deliveriesSource     Delivery[]    @relation("DeliverySourceWarehouse")
  transfersSource      Transfer[]    @relation("TransferSourceWarehouse")
  transfersDestination Transfer[]    @relation("TransferDestinationWarehouse")
  adjustments          Adjustment[]
  ledgerEntries        StockLedger[]
}

model Location {
  id          String   @id @default(uuid())
  warehouseId String
  name        String
  code        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  warehouse            Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stocks               Stock[]
  receiptsDestination  Receipt[]     @relation("ReceiptDestinationLocation")
  deliveriesSource     Delivery[]    @relation("DeliverySourceLocation")
  transfersSource      Transfer[]    @relation("TransferSourceLocation")
  transfersDestination Transfer[]    @relation("TransferDestinationLocation")
  adjustments          Adjustment[]
  ledgerEntries        StockLedger[]

  @@index([warehouseId])
}

// ==========================================
// CURRENT STOCK PER LOCATION
// ==========================================

model Stock {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  locationId  String
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, locationId])
  @@index([productId])
  @@index([warehouseId, locationId])
}

// ==========================================
// SUPPLIER
// ==========================================

model Supplier {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  receipts  Receipt[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==========================================
// STOCK OPERATIONS
// ==========================================

// 1. Receipts (Incoming Stock)
model Receipt {
  id                     String          @id @default(uuid())
  referenceNumber        String          @unique
  supplierId             String
  destinationWarehouseId String
  destinationLocationId  String
  status                 OperationStatus @default(DRAFT)
  notes                  String?
  createdById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relationships
  supplier             Supplier      @relation(fields: [supplierId], references: [id])
  destinationWarehouse Warehouse     @relation("ReceiptDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  destinationLocation  Location      @relation("ReceiptDestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy            User?         @relation(fields: [createdById], references: [id])
  items                ReceiptItem[]

  @@index([supplierId])
  @@index([status])
}

model ReceiptItem {
  id               String   @id @default(uuid())
  receiptId        String
  productId        String
  expectedQuantity Int
  receivedQuantity Int      @default(0)
  unitCost         Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

// 2. Delivery Orders (Outgoing Stock)
model Delivery {
  id                String          @id @default(uuid())
  referenceNumber   String          @unique
  customerName      String
  sourceWarehouseId String
  sourceLocationId  String
  status            OperationStatus @default(DRAFT)
  pickingDone       Boolean         @default(false)
  packingDone       Boolean         @default(false)
  notes             String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relationships
  sourceWarehouse Warehouse      @relation("DeliverySourceWarehouse", fields: [sourceWarehouseId], references: [id])
  sourceLocation  Location       @relation("DeliverySourceLocation", fields: [sourceLocationId], references: [id])
  createdBy       User?          @relation(fields: [createdById], references: [id])
  items           DeliveryItem[]

  @@index([status])
}

model DeliveryItem {
  id              String   @id @default(uuid())
  deliveryId      String
  productId       String
  orderedQuantity Int
  pickedQuantity  Int      @default(0)
  unitPrice       Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
}

// 3. Internal Transfers
model Transfer {
  id                     String          @id @default(uuid())
  referenceNumber        String          @unique
  sourceWarehouseId      String
  sourceLocationId       String
  destinationWarehouseId String
  destinationLocationId  String
  status                 OperationStatus @default(DRAFT)
  notes                  String?
  createdById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relationships
  sourceWarehouse      Warehouse      @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  sourceLocation       Location       @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])
  destinationWarehouse Warehouse      @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  destinationLocation  Location       @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy            User?          @relation(fields: [createdById], references: [id])
  items                TransferItem[]

  @@index([status])
}

model TransferItem {
  id         String   @id @default(uuid())
  transferId String
  productId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

// 4. Inventory Adjustments
model Adjustment {
  id               String          @id @default(uuid())
  referenceNumber  String          @unique
  productId        String
  warehouseId      String
  locationId       String
  recordedQuantity Int
  countedQuantity  Int
  difference       Int
  reason           String
  status           OperationStatus @default(DRAFT)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relationships
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([warehouseId, locationId])
}

// ==========================================
// STOCK LEDGER (AUDIT TRAIL)
// ==========================================

model StockLedger {
  id               String     @id @default(uuid())
  productId        String
  warehouseId      String
  locationId       String
  type             LedgerType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  referenceId      String
  createdById      String?
  createdAt        DateTime   @default(now())

  // Relationships
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([warehouseId, locationId])
  @@index([referenceId])
  @@index([type])
  @@index([createdAt])
}
